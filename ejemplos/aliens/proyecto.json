{"hash":"f2ad0765-e518-4cd5-af21-58898f60e310","fecha":"2025-10-15T20:33:20.916Z","version":"1","screenshot":"data:image/png;base64,","textura":"data:image/png;base64,","codigo":"class Laser():\n    \n    def __init__(self):\n        self.x = mouse_x\n        self.y = mouse_y\n        self.vivo = True\n    \n    def dibujar(self):\n        linea(self.x, self.y, self.x, self.y - 10, 12)\n        self.y -= 4\n        \n        if self.y < 0:\n            self.vivo = False\n        \n    def __repr__(self):\n        return f\"{self.x} {self.y}\"\n        \nclass Alien():\n    def __init__(self):\n        self.x = azar()\n        self.y = azar(0, 100)\n        self.vivo = True\n        \n    def dibujar(self):\n        self.x -= 1\n        if self.x < -50:\n            self.x = 200\n            \n        dibujar(0, self.x, self.y)\n\n\ncosas = []\n\ncosas.append(Alien())\ncosas.append(Alien())\ncosas.append(Alien())\ncosas.append(Alien())\n\nwhile True:\n    pintar(0)\n    \n    print(\"click para disparar\", 11)\n    \n    if click_sin_repetir:\n        sonido(1)\n        circulo(mouse_x, mouse_y, azar(10, 20), 12, True)\n        cosas.append(Laser())\n        \n    for c in cosas:\n        c.dibujar()\n        \n        for x in cosas:\n            if c != x:\n                if distancia(c.x, c.y, x.x, x.y) < 10:\n                    c.vivo = False\n                    x.vivo = False\n                    sonido(2)\n                    circulo(c.x, c.y, 25, 8, True)\n        \n    cosas = [c for c in cosas if c.vivo]","anchoDeTextura":128,"altoDeTextura":40}